import os
import numpy as np
from monoforce.config import DPhysConfig
from monoforce.datasets import robingas_seq_paths, RobinGasVis, rellis3d_seq_paths, Rellis3DVis
from monoforce.datasets.utils import explore_data
from monoforce.utils import read_yaml


def vis_data(dataset, robot='husky'):
    dphys_config_path = '../../monoforce/config/dphys_cfg.yaml'
    lss_config_path = f'../../monoforce/config/lss_cfg_{robot}.yaml'

    if dataset == 'robingas':
        data_paths = robingas_seq_paths[robot]
        DataClass = RobinGasVis
    elif dataset == 'rellis3d':
        data_paths = rellis3d_seq_paths
        DataClass = Rellis3DVis
    else:
        raise ValueError('Invalid dataset %s. Supported: rellis3d and robingas' % dataset)

    for path in data_paths:
        assert os.path.isdir(path), 'Data path %s does not exist' % path
        lss_config = read_yaml(lss_config_path)
        dphys_cfg = DPhysConfig()
        dphys_cfg.from_yaml(dphys_config_path)
        ds = DataClass(path, is_train=False, lss_cfg=lss_config, dphys_cfg=dphys_cfg)
        ds = ds[np.random.choice(len(ds), 32, replace=False)]
        explore_data(ds, sample_range='random', save=False)


def save_visuals():
    robot = 'husky_oru'
    dphys_config_path = '../../monoforce/config/dphys_cfg.yaml'
    lss_config_path = f'../../monoforce/config/lss_cfg_{robot}.yaml'
    data_paths = robingas_seq_paths[robot]
    # data_paths = ['/media/ruslan/SSD/data/bags/ORU/2024_05_01_Husky_Ruslan_Viking_hills_dense/bags/radarize__2024-05-01-15-48-29_0/']

    lss_config = read_yaml(lss_config_path)
    dphys_cfg = DPhysConfig()
    dphys_cfg.from_yaml(dphys_config_path)

    for path in data_paths:
        assert os.path.isdir(path), 'Data path %s does not exist' % path
        if os.path.exists(os.path.join(path, 'visuals')):
            print('Visuals already exist for %s' % path)
            continue
        print('Saving visuals for %s' % os.path.basename(path))
        ds = RobinGasVis(path, is_train=False, lss_cfg=lss_config, dphys_cfg=dphys_cfg)
        explore_data(ds, sample_range='all', save=True)
        # explore_data(ds, sample_range=np.random.choice(range(len(ds)), 5, replace=False), save=False)


def main():
    datasets = ['robingas']
    robots = ['husky_oru']
    for dataset in datasets:
        for robot in robots:
            vis_data(dataset, robot)
            if dataset == 'rellis3d':
                print('Rellis3D does not have multiple robots')
                break
    # save_visuals()


if __name__ == '__main__':
    main()
