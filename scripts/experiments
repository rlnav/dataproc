def fov_masking():
    from skimage.draw import polygon

    robot = np.random.choice(['husky', 'husky_oru', 'tradr'])
    path = np.random.choice(robingas_seq_paths[robot])

    ds = RobinGas(path=path, dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False, only_front_cam=False)
    i = np.random.choice(range(len(ds)))
    print(f'Visualizing sample {i} from {os.path.basename(path)}...')

    img, K = ds.get_image(i)
    img = np.asarray(img)
    print('Image shape:', img.shape)

    # get fov from camera intrinsics
    img_h, img_w = img.shape[:2]
    fx, fy = K[0, 0], K[1, 1]

    fov_x = 2 * np.arctan2(img_h, 2 * fx)
    fov_y = 2 * np.arctan2(img_w, 2 * fy)

    print("Field of View (degrees):")
    fov_x_deg = np.rad2deg(fov_x)
    fov_y_deg = np.rad2deg(fov_y)
    print(f"  {fov_x_deg = :.1f}\N{DEGREE SIGN}")
    print(f"  {fov_y_deg = :.1f}\N{DEGREE SIGN}")

    # camera frustum mask
    d = ds.dphys_cfg.d_max
    res = ds.dphys_cfg.grid_res
    h, w = 2 * d / res, 2 * d / res
    h, w = int(h), int(w)
    mask = np.zeros((h, w))

    to_grid = lambda x: np.array([x[1], x[0]]) / res + np.array([h // 2, w // 2])
    A = to_grid((0, 0))
    B = to_grid((d, d * np.tan(fov_y / 2)))
    C = to_grid((d, -d * np.tan(fov_y / 2)))

    # draw triangle
    rr, cc = polygon([A[0], B[0], C[0]], [A[1], B[1], C[1]], mask.shape)
    mask[rr, cc] = 1

    plt.figure(figsize=(10, 5))
    plt.subplot(1, 2, 1)
    plt.imshow(img)
    plt.subplot(1, 2, 2)
    plt.imshow(mask, cmap='gray', origin='lower')
    plt.show()


def dphys():
    from monoforce.models.dphysics import dphysics, State

    tt = torch.linspace(0., dphys_cfg.traj_sim_time, dphys_cfg.n_samples)
    device = 'cuda'
    pose_step = 100

    # H, W = int(dphys_cfg.d_max * 2 / dphys_cfg.grid_res), int(dphys_cfg.d_max * 2 / dphys_cfg.grid_res)
    # height = np.zeros((H, W), dtype=np.float32)
    # height[H // 3 * 2:, :] = 1.0

    # # gaussian hm
    x = np.linspace(-dphys_cfg.d_max, dphys_cfg.d_max, int(dphys_cfg.d_max * 2 / dphys_cfg.grid_res))
    y = np.linspace(-dphys_cfg.d_max, dphys_cfg.d_max, int(dphys_cfg.d_max * 2 / dphys_cfg.grid_res))
    X, Y = np.meshgrid(x, y)
    height = (1.0 * np.exp(-1.0 * ((X - 0) ** 2 + (Y - 4) ** 2)) +
              4.0 * np.exp(-5.0 * ((X - 1) ** 2 + (Y + 2) ** 2)) +
              2.0 * np.exp(-3.0 * ((X + 2) ** 2 + (Y + 4) ** 2))
              ) / 3.0
    height = np.asarray(height, dtype=np.float32)

    # initialize robot state
    # yaw = np.random.random()-0.5
    yaw = 0.
    state0 = State(xyz=torch.tensor([0., 0., 0.], device=device).view(3, 1),
                   rot=torch.as_tensor(Rotation.from_euler('z', yaw).as_matrix(),
                                       dtype=torch.float32, device=device).view(3, 3),
                   vel=torch.tensor([0., 0., 0.], device=device).view(3, 1),
                   omega=torch.tensor([0., 0., 0.], device=device).view(3, 1),
                   device=device)

    # controls
    ws = np.arange(-0.3, 0.4, 0.1).tolist() + np.arange(-0.3, 0.4, 0.1).tolist()
    vs = (0.5 * np.ones(len(ws) // 2)).tolist() + (-0.5 * np.ones(int(len(ws) // 2))).tolist()
    trajs = []
    for v, w in zip(vs, ws):
        vv = v * torch.ones(dphys_cfg.n_samples)
        ww = w * torch.ones(dphys_cfg.n_samples)
        controls = {'stamps': tt, 'linear_v': vv, 'angular_w': ww}

        # predict states
        with torch.no_grad():
            states, _ = dphysics(height, controls, robot_model=robot, state=state0, dphys_cfg=dphys_cfg, device=device)

            # get translation and rotation matrices
            xyz = states[0][::pose_step].cpu().numpy()
            Rs = states[1][::pose_step].cpu().numpy()
            print('xyz:', xyz.shape)
            print('Rs:', Rs.shape)
            traj = np.zeros((len(xyz), 4, 4))
            traj[:, :3, :3] = Rs
            traj[:, :3, 3:4] = xyz
            traj[:, 3, 3] = 1.
            trajs.append(traj)

    # show height map as a surface and best trajectory in 3D
    fig = plt.figure(figsize=(10, 10))
    ax = fig.add_subplot(111, projection='3d')
    ax.plot_surface(X, Y, height.T, cmap='jet', alpha=0.4)
    # plot trajectoryies
    for traj in trajs:
        ax.plot(traj[:, 0, 3], traj[:, 1, 3], traj[:, 2, 3], 'b', linewidth=1)
    set_axes_equal(ax)
    ax.set_xlabel('X')
    ax.set_ylabel('Y')
    ax.set_zlabel('Z')
    plt.show()

def warp_dphys():
    wp.init()

    num_trajs = 100  # number of simulated trajectories (in parallel)
    dt = 0.001  # simulation timestep
    T = int(10.0 / dt)  # number of simulation timesteps to perform
    device = "cuda"
    grid_res = 0.1

    # hm_dir = os.path.join(robingas_seq_paths['husky_oru'][0], 'terrain/lidar/')
    # hm_path = os.path.join(hm_dir, np.random.choice(os.listdir(hm_dir)))
    # hm = load_heightmap(hm_path)

    # step hm
    hm = np.zeros((128, 128))
    hm[84:, :] = 0.4

    # # gaussian hm
    # x = np.linspace(-dphys_cfg.d_max, dphys_cfg.d_max, 128)
    # y = np.linspace(-dphys_cfg.d_max, dphys_cfg.d_max, 128)
    # X, Y = np.meshgrid(x, y)
    # hm = (1.0 * np.exp(-1.0 * ((X-0)**2 + (Y-4)**2)) +
    #              4.0 * np.exp(-5.0 * ((X-1)**2 + (Y+2)**2)) +
    #              2.0 * np.exp(-3.0 * ((X+2)**2 + (Y+4)**2))
    #              ) / 3.0

    np_hms = [hm for _ in range(num_trajs)]
    res = [grid_res for _ in range(num_trajs)]

    init_poses = np.zeros((num_trajs, 7))
    quat = Rotation.from_euler('xyz', [0, 0, 0], degrees=True).as_quat()
    init_poses[:, 2] = 0.2  # z coordinate
    init_poses[:, 3:] = quat

    assert num_trajs % 2 == 0, 'num_trajs must be even'
    vel_max, omega_max = 0.5, 0.5
    vels_x = np.concatenate([-vel_max * np.ones((num_trajs // 2, T)), vel_max * np.ones((num_trajs // 2, T))])
    omegas_z = np.concatenate([np.linspace(-omega_max, omega_max, num_trajs // 2),
                               np.linspace(-omega_max, omega_max, num_trajs // 2)])
    assert vels_x.shape == (num_trajs, T)
    assert omegas_z.shape == (num_trajs,)
    vels = np.zeros((num_trajs, T, 3))
    vels[:, :, 0] = vels_x
    omegas = np.zeros((num_trajs, 3))
    omegas[:, 2] = omegas_z

    track_vels = np.zeros((num_trajs, T, 2))
    for i in range(num_trajs):
        track_vels[i, :, 0], track_vels[i, :, 1] = vw_to_track_vel(vels[i, :, 0], omegas[i, 2])
    flipper_angles = np.zeros((num_trajs, T, 4))

    simulator = DiffSim(np_hms, res, T, use_renderer=False, device=device)
    simulator.set_init_poses(init_poses)
    simulator.set_control(track_vels, flipper_angles)

    start = time()
    body_q = simulator.simulate(render=False, use_graph=True)
    print('simulation took ', time() - start, ' s')
    body_q_np = body_q.numpy()
    forces_np = simulator.body_f.numpy()
    print('body_q: ', body_q_np.shape)
    print('forces: ', forces_np.shape)
    assert body_q_np.shape == (T + 1, num_trajs, 7)
    assert forces_np.shape == (T, num_trajs, 6)

    # path with the smallest cost
    # costs = np.linalg.norm(forces_np[..., :3], axis=-1).sum(axis=0)
    costs = np.linalg.norm(forces_np[..., :3], axis=-1).sum(axis=0) + np.linalg.norm(forces_np[..., :3], axis=-1).std(axis=0)
    path_lengths = np.sum(np.linalg.norm(np.diff(body_q_np[..., :3], axis=0), axis=2), axis=0)
    assert costs.shape == (num_trajs,)
    assert path_lengths.shape == (num_trajs,)
    unfeasible_path_ids = np.where(path_lengths > 10.0)[0]
    print('unfeasible path ids: ', unfeasible_path_ids)
    if len(unfeasible_path_ids) == num_trajs:
        print('All paths are unfeasible')
        exit(0)
    best_robot = np.argmin(costs)
    num_trajs = body_q_np.shape[1]

    # show height map as a surface and best trajectory in 3D
    fig = plt.figure(figsize=(10, 10))
    ax = fig.add_subplot(111, projection='3d')
    hm_w, hm_h = hm.shape
    X = np.linspace(-hm_w / 2. * grid_res, hm_w / 2. * grid_res, hm_w)
    Y = np.linspace(-hm_h / 2. * grid_res, hm_h / 2. * grid_res, hm_h)
    X, Y = np.meshgrid(X, Y)
    ax.plot_surface(X, Y, hm.T, cmap='jet', alpha=0.4)
    set_axes_equal(ax)
    costs_norm = np.sqrt(normalize(costs))
    colors = np.zeros((num_trajs, 3))
    colors[:, 1] = 1 - costs_norm
    colors[:, 0] = costs_norm
    for i in range(num_trajs):
        if i in unfeasible_path_ids:
            marker = '--'
            linewidth = 1
        elif i == best_robot:
            marker = '-'
            linewidth = 4
        else:
            marker = '-'
            linewidth = 1
        ax.plot(body_q_np[:, i, 0], body_q_np[:, i, 1], body_q_np[:, i, 2], marker,
                linewidth=linewidth, color=colors[i])
    plt.show()


def depth_range_image():
    from monoforce.datasets import RobinGasRGBD

    robot = 'husky_oru'
    paths = robingas_seq_paths[robot][:6] + [robingas_seq_paths[robot][-3]] + [robingas_seq_paths[robot][-1]]
    for path in paths[-1:]:
        ds = RobinGasRGBD(path=path, dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False)
        i = np.random.choice(range(len(ds)))

        rgb, K = ds.get_image(i)
        rgb = np.asarray(rgb)

        depth, points_uv = ds.get_depth_image(i, points_source='radar')

        plt.figure(figsize=(20, 10))
        plt.subplot(1, 2, 1)
        plt.title('Camera Image with Points')
        dist = depth[points_uv[:, 1].astype(int), points_uv[:, 0].astype(int)]
        plt.scatter(points_uv[:, 0], points_uv[:, 1], s=4, c=dist, cmap='jet', alpha=1)
        plt.imshow(rgb)

        plt.subplot(1, 2, 2)
        plt.title('Depth Image')
        plt.imshow(depth, cmap='jet', vmin=0, vmax=1)

        plt.show()

        points = position(ds.get_cloud(i, points_source='radar'))
        pcd = o3d.geometry.PointCloud()
        pcd.points = o3d.utility.Vector3dVector(points)
        o3d.visualization.draw_geometries([pcd])

    # rgbd, rot, tran, intrins, post_rots, post_trans, hm_geom, hm_terrain = ds[i]
