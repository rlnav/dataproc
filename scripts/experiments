def merge_heightmaps():
    from monoforce.cloudproc import merge_heightmaps
    from monoforce.transformations import transform_cloud

    ds = RobinGas(path=robingas_seq_paths['husky_oru'][0], dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False)

    n_frames = 100
    i = np.random.choice(range(len(ds)-n_frames))
    merged_hm_points = None
    global_hm_cloud = []
    for i in tqdm(range(i, i+n_frames, 5)):
        hm = ds.get_geom_height_map(i)
        pose = ds.get_pose(i)
        hm_points = hm_to_cloud(hm[0], ds.dphys_cfg.d_max, mask=hm[1]).cpu().numpy()
        hm_points = transform_cloud(hm_points, pose)
        print('New heightmap points shape:', hm_points.shape)

        if merged_hm_points is None:
            merged_hm_points = hm_points
        else:
            merged_hm_points = merge_heightmaps(hm_points, merged_hm_points, ds.dphys_cfg.grid_res)
            print('Merged heightmap points shape:', merged_hm_points.shape)

        global_hm_cloud.append(hm_points)
    global_hm_cloud = np.concatenate(global_hm_cloud, axis=0)

    # plot global cloud with open3d
    hm_pcd = o3d.geometry.PointCloud()
    hm_pcd.points = o3d.utility.Vector3dVector(global_hm_cloud)
    # hm_pcd.paint_uniform_color([0, 1, 0])

    o3d.visualization.draw_geometries([hm_pcd])

    # x = np.linspace(-6.4, 6.4, 128)
    # y = np.linspace(-6.4, 6.4, 128)
    # X, Y = np.meshgrid(x, y)
    # Z1 = np.zeros_like(X)
    # Z1[64:, :] = -1.0
    #
    # hm1 = np.stack((X, Y, Z1), axis=-1).reshape(-1, 3)
    # pose1 = np.eye(4)
    # hm1 = transform_cloud(hm1, pose1)
    # print('Heightmap 1 z values:', np.unique(hm1[:, 2]))
    #
    # Z2 = np.zeros_like(X)
    # Z2[:64, :] = 1.0
    #
    # hm2 = np.stack((X, Y, Z2), axis=-1).reshape(-1, 3)
    # pose2 = np.eye(4)
    # pose2[1, 3] = 6.4
    # hm2 = transform_cloud(hm2, pose2)
    # print('Heightmap 2 z values:', np.unique(hm2[:, 2]))
    #
    # hm_merged = merge_heightmaps(new_points=hm2.copy(), prev_points=hm1.copy())
    # print('Merged heightmap z values:', np.unique(hm_merged[:, 2]))
    #
    # pcd1 = o3d.geometry.PointCloud()
    # pcd1.points = o3d.utility.Vector3dVector(hm1)
    # pcd1.paint_uniform_color([1, 0, 0])
