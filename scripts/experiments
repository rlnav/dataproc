def radar_lidar_clouds():
    ds = ROUGH(path=rough_seq_paths['husky_oru'][-2], dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False)

    i = 100
    lidar_cloud = ds.get_cloud(i, points_source='lidar')
    radar_cloud = ds.get_cloud(i, points_source='radar')

    lidar_pcd = o3d.geometry.PointCloud()
    lidar_pcd.points = o3d.utility.Vector3dVector(position(lidar_cloud))
    lidar_pcd.paint_uniform_color([1, 0, 0])

    radar_pcd = o3d.geometry.PointCloud()
    radar_pcd.points = o3d.utility.Vector3dVector(position(radar_cloud))
    radar_pcd.paint_uniform_color([0, 0, 1])

    o3d.visualization.draw_geometries([lidar_pcd, radar_pcd])


def rough_test():
    from monoforce.datasets import ROUGH, rough_seq_paths

    robot = 'marv'
    for i in range(len(rough_seq_paths[robot])):
        ds = ROUGH(path=rough_seq_paths[robot][i], dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False)
        for j in tqdm(range(len(ds))):
            t0 = time()
            ts, controls = ds.get_controls(j)
            t1 = time()
            print('Time to get controls:', t1 - t0)


def bevfusion_test():
    import torch
    from torch.utils.data import DataLoader
    from time import time
    import matplotlib.pyplot as plt
    import numpy as np
    from monoforce.datasets.rough import ROUGH, rough_seq_paths
    from monoforce.utils import read_yaml, position
    from monoforce.transformations import transform_cloud
    from monoforce.dphys_config import DPhysConfig
    from monoforce.models.terrain_encoder.bevfusion import BEVFusion
    from monoforce.models.terrain_encoder.lidarbev import LidarBEV

    class Data(ROUGH):
        def __init__(self, path, lss_cfg, dphys_cfg=DPhysConfig(), is_train=True):
            super(Data, self).__init__(path, lss_cfg, dphys_cfg=dphys_cfg, is_train=is_train)

        def get_cloud(self, i, points_source='lidar'):
            cloud = self.get_raw_cloud(i)
            # move points to robot frame
            Tr = self.calib['transformations']['T_base_link__os_sensor']['data']
            Tr = np.asarray(Tr, dtype=float).reshape((4, 4))
            cloud = transform_cloud(cloud, Tr)
            return cloud

        def get_sample(self, i):
            imgs, rots, trans, intrins, post_rots, post_trans = self.get_images_data(i)
            points = torch.as_tensor(position(self.get_cloud(i))).T
            return (imgs, rots, trans, intrins, post_rots, post_trans, points)

    device = 'cuda'
    lss_cfg = read_yaml('../../monoforce/monoforce/config/lss_cfg.yaml')

    ds = Data(path=rough_seq_paths[0], lss_cfg=lss_cfg)
    loader = DataLoader(ds, batch_size=1, shuffle=False)
    print(f'Dataset length: {len(ds)}')

    # bevfusion = BEVFusion(grid_conf=lss_cfg['grid_conf'], data_aug_conf=lss_cfg['data_aug_conf'])
    # bevfusion.to(device)
    lidarbev = LidarBEV(grid_conf=lss_cfg['grid_conf'], outC=1)
    lidarbev.to(device)

    # get data sample
    batch = next(iter(loader))
    batch = [b.to(device) for b in batch]
    (imgs, rots, trans, intrins, post_rots, post_trans, points) = batch
    imgs_input = batch[:6]
    points = points[..., ::100]  # downsample for visualization

    with torch.no_grad():
        for _ in range(5):
            t0 = time()
            voxel_grid = lidarbev.lidar_net.voxelize(points)
            # voxel_grid = bevfusion.lidar_net.voxelize(points)
            print('Time to voxelize:', time() - t0)
            print('Voxel grid shape:', voxel_grid.shape)

        for _ in range(5):
            t1 = time()
            out = lidarbev(points)
            # out = bevfusion(imgs_input, points)
            terrain_pred = out['terrain']
            print('Time to predict terrain:', time() - t1)
            print('Terrain prediction shape:', terrain_pred.shape)

            lidar_features = lidarbev.lidar_net(points)

    # plot voxels
    fig = plt.figure(figsize=(20, 10))
    # ax = fig.add_subplot(121, projection='3d')
    # ax.voxels(voxel_grid.permute(1, 2, 0).cpu())
    # set_axes_equal(ax)
    # ax.view_init(elev=90, azim=0)

    ax = fig.add_subplot(131)
    ax.imshow(terrain_pred[0, 0].cpu().numpy(), cmap='jet', origin='lower')
    ax.axis('off')

    ax = fig.add_subplot(132)
    ax.imshow(lidar_features[0, 0].cpu().numpy(), cmap='jet', origin='lower')
    ax.axis('off')

    ax = fig.add_subplot(133)
    terrain_height = ds.get_terrain_height_map(0)[0]
    ax.imshow(terrain_height.cpu().numpy(), cmap='jet', origin='lower')

    # ax = fig.add_subplot(131, projection='3d')
    # ax.voxels(voxel_grid[0, 0].permute(1, 2, 0).cpu())
    # set_axes_equal(ax)
    # ax.view_init(elev=90, azim=0)
    #
    # ax = fig.add_subplot(132)
    # ax.imshow(terrain_pred[0, 0].cpu().numpy(), cmap='jet', origin='lower', vmin=-1, vmax=1)
    # ax.axis('off')
    #
    # ax = fig.add_subplot(133, projection='3d')
    # ax.scatter(points[0, 0].cpu(), points[0, 1].cpu(), points[0, 2].cpu(), s=1)
    # # set_axes_equal(ax)
    # ax.set_xlim(-6.4, 6.4)
    # ax.set_ylim(-6.4, 6.4)
    # ax.view_init(elev=90, azim=0)

    plt.show()

def merge_heightmaps1():
    from monoforce.cloudproc import merge_heightmaps, hm_to_cloud
    from monoforce.transformations import position, transform_cloud
    from monoforce.datasets.rough import ROUGH, rough_seq_paths
    from monoforce.dphys_config import DPhysConfig
    from monoforce.utils import read_yaml
    from tqdm import tqdm
    import numpy as np
    import open3d as o3d
    from scipy.spatial.transform import Rotation

    dphys_cfg = DPhysConfig()
    lss_cfg = read_yaml('../../monoforce/monoforce/config/lss_cfg.yaml')

    ds = ROUGH(path=rough_seq_paths[0], dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False)

    def gravity_aligned_pose(pose):
        R = pose[:3, :3]
        roll, pitch, yaw = Rotation.from_matrix(R).as_euler('xyz')
        R_yaw = Rotation.from_euler(angles=[0., 0., yaw], seq='xyz').as_matrix()
        pose[:3, :3] = R_yaw
        return pose

    def get_points(i):
        points = position(ds.get_cloud(i))
        pose = ds.get_pose(i)
        # pose = gravity_aligned_pose(pose)
        points = transform_cloud(points, pose)
        return points

    def get_hm_poinst(i):
        hm = ds.get_geom_height_map(i)
        pose = ds.get_pose(i)
        # pose = gravity_aligned_pose(pose)
        hm_points = hm_to_cloud(hm[0], dphys_cfg, mask=hm[1]).cpu().numpy()
        hm_points = transform_cloud(hm_points, pose)
        return hm_points

    step = 5
    i = 436
    # i = np.random.choice(range(len(ds)-step))
    print(i)

    points1 = get_hm_poinst(i)
    pose1 = ds.get_pose(i)
    # points1 = get_points(i)

    j = i + step
    points2 = get_hm_poinst(j)
    pose2 = ds.get_pose(j)
    # points2 = get_points(j)

    pcd1 = o3d.geometry.PointCloud()
    pcd1.points = o3d.utility.Vector3dVector(points1)
    pcd1.paint_uniform_color([1, 0, 0])

    pcd2 = o3d.geometry.PointCloud()
    pcd2.points = o3d.utility.Vector3dVector(points2)
    pcd2.paint_uniform_color([0, 0, 1])

    cf1 = o3d.geometry.TriangleMesh.create_coordinate_frame(size=1.0, origin=[0.0, 0.0, 0.0])
    cf1.transform(pose1)

    cf2 = o3d.geometry.TriangleMesh.create_coordinate_frame(size=1.0, origin=[0.0, 0.0, 0.0])
    cf2.transform(pose2)

    o3d.visualization.draw_geometries([pcd1, pcd2, cf1, cf2])



