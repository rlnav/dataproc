def load_heightmap(path):
    heightmap = np.load(path, allow_pickle=True).item()['z']
    return heightmap


def vw_to_track_vel(v, w, r=1.0):
    # v: linear velocity, w: angular velocity, r: robot radius
    # v = (v_r + v_l) / 2
    # w = (v_r - v_l) / (2 * r)
    v_r = v + r * w
    v_l = v - r * w
    return v_r, v_l

