def fov_masking():
    from skimage.draw import polygon

    robot = np.random.choice(['husky', 'husky_oru', 'tradr'])
    path = np.random.choice(robingas_seq_paths[robot])

    ds = RobinGas(path=path, dphys_cfg=dphys_cfg, lss_cfg=lss_cfg, is_train=False, only_front_cam=False)
    i = np.random.choice(range(len(ds)))
    print(f'Visualizing sample {i} from {os.path.basename(path)}...')

    img, K = ds.get_image(i)
    img = np.asarray(img)
    print('Image shape:', img.shape)

    # get fov from camera intrinsics
    img_h, img_w = img.shape[:2]
    fx, fy = K[0, 0], K[1, 1]

    fov_x = 2 * np.arctan2(img_h, 2 * fx)
    fov_y = 2 * np.arctan2(img_w, 2 * fy)

    print("Field of View (degrees):")
    fov_x_deg = np.rad2deg(fov_x)
    fov_y_deg = np.rad2deg(fov_y)
    print(f"  {fov_x_deg = :.1f}\N{DEGREE SIGN}")
    print(f"  {fov_y_deg = :.1f}\N{DEGREE SIGN}")

    # camera frustum mask
    d = ds.dphys_cfg.d_max
    res = ds.dphys_cfg.grid_res
    h, w = 2 * d / res, 2 * d / res
    h, w = int(h), int(w)
    mask = np.zeros((h, w))

    to_grid = lambda x: np.array([x[1], x[0]]) / res + np.array([h // 2, w // 2])
    A = to_grid((0, 0))
    B = to_grid((d, d * np.tan(fov_y / 2)))
    C = to_grid((d, -d * np.tan(fov_y / 2)))

    # draw triangle
    rr, cc = polygon([A[0], B[0], C[0]], [A[1], B[1], C[1]], mask.shape)
    mask[rr, cc] = 1

    plt.figure(figsize=(10, 5))
    plt.subplot(1, 2, 1)
    plt.imshow(img)
    plt.subplot(1, 2, 2)
    plt.imshow(mask, cmap='gray', origin='lower')
    plt.show()



