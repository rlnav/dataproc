<?xml version="1.0" encoding="UTF-8" ?>

<launch>
    <arg name="rviz" default="true"/>
    <arg name="lidar" default="os0"/>

    <param name="use_sim_time" value="true"/>
    <include file="$(dirname)/$(arg lidar)_replay.launch"/>

    <!-- Point cloud range filter -->
    <node name="gridmap_masker" pkg="dataproc" type="gridmap_masker" output="screen">
        <rosparam subst_value="true">
            gridmap_topic: /grid_map/terrain
        </rosparam>
<!--         <remap from="input" to="ouster/points"/> -->
<!--         <remap from="output" to="ouster/points_in_range"/> -->
    </node>

    <!-- Rviz -->
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(dirname)/../config/rviz/icml_diff_xyz.rviz"/>
</launch>
